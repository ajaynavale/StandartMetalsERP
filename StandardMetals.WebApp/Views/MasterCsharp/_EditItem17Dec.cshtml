@model StandardMetals.MODEL.ItemMasterModalApril2026


<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Edit Item</title>
</head>
<body>
    <!-----------Model Header--------->

    <div class="modal-dialog modal-lg custom-modal-sm">
        <div class="modal-content">
            <div class="modal-header custom-header" style="display:flex;">
                <h2>Edit Item</h2>
                <button type="button" class="close" data-dismiss="modal" style="margin-left:auto;">&times;</button>
            </div>

            <div class="modal-body" style="padding-bottom:0px">
                <section id="Test">
                    <div>

                        <div class="box box-info">
                            <!-- /.box-header -->

                            <div class="box-body">
                                <div class="formcolor section-box">

                                    @*================================================================================================*@
                                    @using (Html.BeginForm("EditItem17Dec", "MasterCsharp", FormMethod.Post, new { id = "EditForm" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.HiddenFor(model => model.Id)
                                        <div class="form-horizontal">
                                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                            <div class="row">
                                                <div class="col-md-2">
                                                    @Html.LabelFor(model => model.ItemCode, htmlAttributes: new { @class = "control-label col-md-2" })
                                                </div>
                                                <div class="col-md-4">
                                                    @Html.EditorFor(model => model.ItemCode, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                                                    @Html.ValidationMessageFor(model => model.ItemCode, "", new { @class = "text-danger" })
                                                </div>



                                                <div class="col-md-2">
                                                    @Html.LabelFor(model => model.ItemName, "Name", htmlAttributes: new { @class = "control-label col-md-2" })
                                                </div>
                                                <div class="col-md-4">
                                                    @Html.EditorFor(model => model.ItemName, new { htmlAttributes = new { @class = "form-control" } })
                                                    @Html.ValidationMessageFor(model => model.ItemName, "", new { @class = "text-danger" })
                                                </div>

                                            </div>

                                            <div class="row">
                                                <div class="col-md-2">
                                                    @Html.LabelFor(model => model.ManufactureId, "Manufacturer", htmlAttributes: new { @class = "control-label col-md-2" })
                                                </div>
                                                <div class="col-md-4">
                                                    @Html.DropDownListFor(model => model.ManufactureId,
                                                    new SelectList(ViewBag.Manufacturers, "ManufactureId", "ManufactureName"), "Select",
                                                    htmlAttributes: new { @class = "form-control" })
                                                    @Html.ValidationMessageFor(model => model.ManufactureId, "", new { @class = "text-danger" })
                                                </div>

                                                <div class="col-md-2">
                                                    @Html.LabelFor(model => model.Material, htmlAttributes: new { @class = "control-label col-md-2" })
                                                </div>
                                                <div class="col-md-4">
                                                    @Html.EditorFor(model => model.Material, new { htmlAttributes = new { @class = "form-control" } })
                                                    @Html.ValidationMessageFor(model => model.Material, "", new { @class = "text-danger" })
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-md-2">
                                                    @Html.LabelFor(model => model.CategoryId, "Category", htmlAttributes: new { @class = "control-label col-md-2" })
                                                </div>
                                                <div class="col-md-4">
                                                    @Html.DropDownListFor(model => model.CategoryId,
                                                    new SelectList(ViewBag.Categories, "CategoryId", "CategoryName"), "Select",
                                                    htmlAttributes: new { @class = "form-control" })
                                                    @Html.ValidationMessageFor(model => model.CategoryId, "", new { @class = "text-danger" })
                                                </div>


                                                <div class="col-md-2">
                                                    @Html.LabelFor(model => model.SubCategoryId, "SubCategory", htmlAttributes: new { @class = "control-label col-md-2" })
                                                </div>
                                                <div class="col-md-4">
                                                    @Html.DropDownListFor(model => model.SubCategoryId,
                                                    new SelectList(ViewBag.SubCategories, "SubCategoryId", "SubCategoryName"), "Select",
                                                    htmlAttributes: new { @class = "form-control" })
                                                    @Html.ValidationMessageFor(model => model.SubCategoryId, "", new { @class = "text-danger" })
                                                </div>
                                            </div>



                                            <div class="row">
                                                <div class="col-md-2">
                                                    @Html.LabelFor(model => model.ColourId, "Colour", htmlAttributes: new { @class = "control-label col-md-2" })
                                                </div>
                                                <div class="col-md-4">
                                                    @Html.DropDownListFor(model => model.ColourId,
                                                   new SelectList(ViewBag.ColourList, "ColourId", "ColourName"), "Select",
                                                   htmlAttributes: new { @class = "form-control" })
                                                    @Html.ValidationMessageFor(model => model.ColourId, "", new { @class = "text-danger" })
                                                </div>

                                                <div class="col-md-2">
                                                    @Html.LabelFor(model => model.UnitId, "Unit", htmlAttributes: new { @class = "control-label col-md-2" })
                                                </div>
                                                <div class="col-md-4">
                                                    @Html.DropDownListFor(model => model.UnitId,
                                                    new SelectList(ViewBag.UnitList, "UnitId", "UnitName"), "Select",
                                                    htmlAttributes: new { @class = "form-control" })
                                                    @Html.ValidationMessageFor(model => model.UnitId, "", new { @class = "text-danger" })
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-md-2">
                                                    @Html.LabelFor(model => model.HSNCODE, "HSN-Code", htmlAttributes: new { @class = "control-label col-md-2" })
                                                </div>
                                                <div class="col-md-4">
                                                    @Html.EditorFor(model => model.HSNCODE, new { htmlAttributes = new { @class = "form-control" } })
                                                    @Html.ValidationMessageFor(model => model.HSNCODE, "", new { @class = "text-danger" })
                                                </div>


                                                <div class="col-md-2">
                                                    @Html.LabelFor(model => model.GSTRate, "GST Rate", htmlAttributes: new { @class = "control-label col-md-2" })
                                                </div>
                                                <div class="col-md-4">
                                                    @Html.EditorFor(model => model.GSTRate, new { htmlAttributes = new { @class = "form-control" } })
                                                    @Html.ValidationMessageFor(model => model.GSTRate, "", new { @class = "text-danger" })
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-md-2">
                                                    @Html.LabelFor(model => model.PurchaseCost, htmlAttributes: new { @class = "control-label col-md-2" })
                                                </div>
                                                <div class="col-md-4">
                                                    @Html.EditorFor(model => model.PurchaseCost, new { htmlAttributes = new { @class = "form-control" } })
                                                    @Html.ValidationMessageFor(model => model.PurchaseCost, "", new { @class = "text-danger" })
                                                </div>


                                                <div class="col-md-2">
                                                    @Html.LabelFor(model => model.SellingPrice, htmlAttributes: new { @class = "control-label col-md-2" })
                                                </div>
                                                <div class="col-md-4">
                                                    @Html.EditorFor(model => model.SellingPrice, new { htmlAttributes = new { @class = "form-control" } })
                                                    @Html.ValidationMessageFor(model => model.SellingPrice, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                            <br />
                                            <br />

                                            <section id="SupplierMaster">

                                                <div class="col-lg-12 col-md-12">

                                                    <div class="box box-info">

                                                        <div class="box-header with-border">

                                                            <h3 class="box-title">
                                                                Supplier Details
                                                            </h3>
                                                        </div>


                                                        <div class="box-body">

                                                            <div class="col-md-4">

                                                                <strong class="align text-center">
                                                                    Supplier Code
                                                                </strong>

                                                                <div class="dropdown">

                                                                    @*@Html.DropDownList("SupplierCode", ViewBag.SupplierCode as SelectList, "Select Supplier Code", new { @class = "form-control", id = "ddlSearchSuppCode" })*@

                                                                </div>

                                                            </div>


                                                            <div class="col-md-4">

                                                                <strong class="align text-center">
                                                                    Supplier Name
                                                                </strong>

                                                                <div class="dropdown">

                                                                    @*@Html.DropDownList("SupplierName", ViewBag.SupplierName as SelectList, "Select Supplier Name", new { @class = "form-control", id = "ddlSearchSuppName" })*@

                                                                </div>

                                                            </div>


                                                            <div class="col-md-2">

                                                                <div class="form-group">

                                                                    <label>&nbsp;</label>

                                                                    <br />

                                                                    <input id="btnAddSupplier" type="button" value="Add" class="btn btn-sm- btn-primary" />

                                                                </div>

                                                            </div>

                                                            <!-- ADDED SUPPLIER LIST -->

                                                            <div class="col-md-12"
                                                                 style="margin-top:15px;">

                                                                <table id="tblItemSupplier"
                                                                       class="table table-bordered table-striped">

                                                                    <thead>

                                                                        <tr>

                                                                            <th> Supplier Code</th>

                                                                            <th> Supplier Name</th>

                                                                            <th style="width:100px;">Action </th>

                                                                        </tr>

                                                                    </thead>

                                                                    <tbody id="supplierListBody"></tbody>

                                                                </table>

                                                            </div>

                                                        </div>

                                                    </div>

                                                </div>

                                            </section>

                                            <br />
                                            <br />

                                            <section id="CustomerMaster">

                                                <div class="col-lg-12 col-md-12">

                                                    <div class="box box-info">

                                                        <div class="box-header with-border">

                                                            <h3 class="box-title">
                                                                Customer Details
                                                            </h3>
                                                        </div>


                                                        <div class="box-body">

                                                            <div class="col-md-4">

                                                                <strong class="align text-center">
                                                                    Customer Code
                                                                </strong>

                                                                <div class="dropdown">

                                                                    @*@Html.DropDownList("CustomerCode", ViewBag.CustomerCode as SelectList, "Select Customer Code", new { @class = "form-control", id = "ddlSearchCustCode" })*@

                                                                </div>

                                                            </div>


                                                            <div class="col-md-4">

                                                                <strong class="align text-center">
                                                                    Customer Name
                                                                </strong>

                                                                <div class="dropdown">

                                                                    @*@Html.DropDownList("CustomerName", ViewBag.CustomerName as SelectList, "Select Customer Name", new { @class = "form-control", id = "ddlSearchCustName" })*@

                                                                </div>

                                                            </div>


                                                            <div class="col-md-2">

                                                                <div class="form-group">

                                                                    <label>&nbsp;</label>

                                                                    <br />

                                                                    <input id="btnAddCustomer" type="button" value="Add" class="btn btn-sm- btn-primary" />

                                                                </div>

                                                            </div>

                                                            <!-- ADDED SUPPLIER LIST -->

                                                            <div class="col-md-12"
                                                                 style="margin-top:15px;">

                                                                <table id="tblItemCustomer"
                                                                       class="table table-bordered table-striped">

                                                                    <thead>

                                                                        <tr>

                                                                            <th> Customer Code</th>

                                                                            <th> Customer Name</th>

                                                                            <th style="width:100px;">Action </th>

                                                                        </tr>

                                                                    </thead>

                                                                    <tbody id="CustomerListBody"></tbody>

                                                                </table>

                                                            </div>

                                                        </div>

                                                    </div>

                                                </div>

                                            </section>

                                            <br />
                                            <br />



                                            <div class="form-group">
                                                <div class="modal-footer justify-content-end">
                                                    <input type="submit" value="Update" class="btn btn-success" />
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    <!-----------Model Footer--------->
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
</body>
</html>


<script>
    $(document).ready(function () {

        // 1. ENABLE MVC VALIDATION

        $("#EditForm").removeData("validator");
        $("#EditForm").removeData("unobtrusiveValidation");

        $.validator.unobtrusive.parse("#EditForm");

        $.validator.addMethod("greaterThan", function (value, element) {
            return parseFloat(value) > parseFloat($("#PurchaseCost").val());
        }, "Selling Price must be greater than Purchase Cost");

        $("#SellingPrice").rules("add", {
            greaterThan: true
        });

        // 2. ADD SEARCH BOX TO ALL DROPDOWNS


        $("#EditForm select").select2({
            width: "100%",
            placeholder: "Select",
            closeOnSelect: true,
            allowClear: true,
            dropdownParent: $("#myModal .modal-content")

        });


        // 3. CATEGORY -> SUBCATEGORY


        $("#CategoryId").change(function () {

            var categoryId = $(this).val();
            var subCategory = $("#SubCategoryId");

            // Clear old values
            subCategory.empty();

            // Add default option
            subCategory.append($("<option>", {value: "",text: "Select"}));

            // If category is not selected
            if (!categoryId) {
                subCategory.trigger("change");
                return;
            }

            // Get subcategories
            $.ajax({
                url: '@Url.Action("GetSubCategoryN", "MasterCsharp")',
                type: "GET",
                data: { id: categoryId },

                success: function (data) {

                    $.each(data, function (i, item) {

                        subCategory.append($("<option>", { value: item.SubCategoryId,text: item.SubCategoryName}));

                    });

                    // Refresh Select2
                    subCategory.trigger("change");
                },

                error: function () {
                    alert("Unable to load subcategories.");
                }
            });
        });


        // 4. SUPPLIER CODE -> SUPPLIER NAME

        $("#ddlSearchSuppCode").change(function () {

            var supplierCode = $(this).val();


            $("#ddlSearchSuppName").val(supplierCode).trigger("change.select2");

        });

        // 5. SUPPLIER NAME -> SUPPLIER CODE

        $("#ddlSearchSuppName").change(function () {

            var supplierName = $(this).val();


            $("#ddlSearchSuppCode").val(supplierName).trigger("change.select2");

        });

        // 6. CUSTOMER CODE -> CUSTOMER NAME

        $("#ddlSearchCustCode").change(function () {

            var customerCode = $(this).val();


            $("#ddlSearchCustName").val(customerCode).trigger("change.select2");

        });

        // 7. CUSTOMER NAME -> CUSTOMER CODE

        $("#ddlSearchCustName").change(function () {

            var customerName = $(this).val();


            $("#ddlSearchCustCode").val(customerName).trigger("change.select2");

        });

        // SHOW EXISTING SUPPLIERS

        var supplierList = @Html.Raw(Json.Encode(Model.SupplierList));

        $.each(supplierList, function (i, supplier) {

            $("#supplierListBody").append(
                "<tr>" +
                "<td>" +
                supplier.SupplierCode +
                "<input type='hidden' " +
                "class='supplierId' " +
                "name='SupplierList[" + i + "].SupplierID' " +
                "value='" + supplier.SupplierID + "' />" +
                "</td>" +

                "<td>" + supplier.SupplierName + "</td>" +

                "<td>" +
                "<button type='button' " +
                "class='btn btn-danger btn-sm removeSupplier'>" +
                "Remove" +
                "</button>" +
                "</td>" +
                "</tr>"
            );
        });


        // SHOW EXISTING CUSTOMERS

        var customerList = @Html.Raw(Json.Encode(Model.CustList));

        $.each(customerList, function (i, customer) {

            $("#CustomerListBody").append(
                "<tr>" +
                "<td>" +
                customer.CustomerCode +
                "<input type='hidden' " +
                "class='customerId' " +
                "name='CustList[" + i + "].CustomerId' " +
                "value='" + customer.CustomerId + "' />" +
                "</td>" +

                "<td>" + customer.CustomerName + "</td>" +

                "<td>" +
                "<button type='button' " +
                "class='btn btn-danger btn-sm removeCustomer'>" +
                "Remove" +
                "</button>" +
                "</td>" +
                "</tr>"
            );
        });


        toggleSupplierCustomer();

        // Add btn

        $("#btnAddSupplier").click(function () {

            var supplierId = $("#ddlSearchSuppCode").val();
            var supplierCode = $("#ddlSearchSuppCode option:selected").text();
            var supplierName = $("#ddlSearchSuppName option:selected").text();

            if (!supplierId) {
                alert("Please select Supplier.");
                return;
            }

            // Prevent duplicate supplier
            var exists = false;

            $("#supplierListBody tr").each(function () {
                if ($(this).find(".supplierId").val() == supplierId) {
                    exists = true;
                    return false;
                }
            });

            if (exists) {
                alert("Supplier already added.");
                return;
            }

            var row = ` <tr>
            <td>
                ${supplierCode}
                <input type="hidden"
                       class="supplierId"
                       name="SupplierList[].SupplierID"
                       value="${supplierId}" />
            </td>

            <td>${supplierName}</td>

            <td>
                <button type="button"
                        class="btn btn-danger btn-sm removeSupplier">
                    Remove
                </button>
            </td>
        </tr> `;

            $("#supplierListBody").append(row);

            rebuildSupplierIndexes();

            // Clear dropdowns
            $("#ddlSearchSuppCode").val(null).trigger("change.select2");
            $("#ddlSearchSuppName").val(null).trigger("change.select2");

            toggleSupplierCustomer();
        });


        function rebuildSupplierIndexes() {

            $("#supplierListBody tr").each(function (index) {

                $(this).find(".supplierId").attr("name", "SupplierList[" + index + "].SupplierID");
            });
        }



        $("#btnAddCustomer").click(function () {

            var customerId = $("#ddlSearchCustCode").val();
            var customerCode = $("#ddlSearchCustCode option:selected").text();
            var customerName = $("#ddlSearchCustName option:selected").text();

            if (!customerId) {
                alert("Please select Customer.");
                return;
            }

            // Prevent duplicate customer
            var exists = false;

            $("#CustomerListBody tr").each(function () {

                if ($(this).find(".customerId").val() == customerId) {
                    exists = true;
                    return false;
                }
            });

            if (exists) {
                alert("Customer already added.");
                return;
            }

            var row = `<tr>
            <td>
                ${customerCode}

                <input type="hidden"
                       class="customerId"
                       name="CustList[].CustomerId"
                       value="${customerId}" />
            </td>

            <td>${customerName}</td>

            <td>
                <button type="button"
                        class="btn btn-danger btn-sm removeCustomer">
                    Remove
                </button>
            </td>
        </tr> `;

            $("#CustomerListBody").append(row);

            rebuildCustomerIndexes();

            // Clear dropdowns
            $("#ddlSearchCustCode").val(null).trigger("change.select2");
            $("#ddlSearchCustName").val(null).trigger("change.select2");

            toggleSupplierCustomer();
        });



        function rebuildCustomerIndexes() {

            $("#CustomerListBody tr").each(function (index) {

                $(this).find(".customerId").attr("name", "CustList[" + index + "].CustomerId");
            });
        }


        // REMOVE SUPPLIER

        $(document).on("click", ".removeSupplier", function () {

            $(this).closest("tr").remove();

            rebuildSupplierIndexes();


            toggleSupplierCustomer();
        });


        // REMOVE CUSTOMER

        $(document).on("click", ".removeCustomer", function () {

            $(this).closest("tr").remove();

            rebuildCustomerIndexes();


            toggleSupplierCustomer();

        });


        $("#EditForm").submit(function (e) {

            e.preventDefault();

            $.ajax({
                url: $(this).attr("action"),
                type: "POST",
                data: $(this).serialize(),

                success: function (response) {

                    if (response.success) {

                        alert(response.message);

                        // close modal
                        $("#myModal").modal("hide");

                        location.reload();
                    }
                    else {
                        alert(response.message || "Update failed.");
                    }
                },

                error: function (xhr) {

                    console.log(xhr.responseText);

                    alert("Something went wrong while updating.");
                }
            });

        });


        function toggleSupplierCustomer()
        {

            const hasSupplier = $("#supplierListBody tr").length > 0;
            const hasCustomer = $("#CustomerListBody tr").length > 0;

            const supplierControls = "#ddlSearchSuppCode, #ddlSearchSuppName, #btnAddSupplier";

            const customerControls = "#ddlSearchCustCode, #ddlSearchCustName, #btnAddCustomer";

            if (hasSupplier)
            {

                $(supplierControls).prop("disabled", false);
                $(customerControls).prop("disabled", true);

            }
            else if (hasCustomer)
            {

                $(supplierControls).prop("disabled", true);
                $(customerControls).prop("disabled", false);

            }
            else
            {

                $(supplierControls).prop("disabled", false);
                $(customerControls).prop("disabled", false);
            }
        }


    });
</script>


<style>
    .row {
        padding: 10px;
    }

    .section-box {
        padding-top: 5px;
    }

    .modal-body {
        padding-top: 5px;
    }

    .form-title {
        margin-left: 8 px;
        font-size: 24px;
    }
</style>
