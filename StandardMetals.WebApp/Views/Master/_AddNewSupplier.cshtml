@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}



<script type="text/javascript">

    $(document).ready(function () {

        $("#AddSupplier").removeData("validator");
        $("#AddSupplier").removeData("unobtrusiveValidation");
        $.validator.unobtrusive.parse("#AddSupplier");

        $("#AddSupplier select").select2({
            width: "100%",
            placeholder: "Select",
            closeOnSelect: true,
            allowClear: true,
            dropdownParent: $("#myModal .modal-content")
        });

        $(document).on("submit", "#AddSupplier", function (e) {

            e.preventDefault();
            var form = $(this);
            if (!form.valid()) {
                return false;
            }

            $.ajax({
                url: form.attr("action"),
                type: "POST",
                data: form.serialize(),
                success: function (response) {
                    if (response) {
                        alert(response.Message + "\n\n Generated Supplier Code is : " + response.code);

                        $(".modal").modal("hide");
                        location.reload();

                    }
                }
            });
        });


    });

</script>