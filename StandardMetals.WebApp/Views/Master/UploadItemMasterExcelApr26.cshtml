@{
    ViewBag.Title = "Upload Item Master Excel";
}

<br />

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@3.4.1/dist/css/bootstrap.min.css">

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@3.4.1/dist/js/bootstrap.min.js"></script>


@if (ViewBag.Message != null)
{
    <script>
        alert('@ViewBag.Message');
    </script>
}


<!-- UPLOAD EXCEL SECTION -->

<section id="Test">

    <div class="col-lg-12 col-md-12">

        <div class="box box-info">

            <!-- ================= HEADER ================= -->

            <div class="box-header with-border">

                <h3 class="box-title">
                    Upload @*Item Master*@ Excel
                </h3>

                <div class="box-tools pull-right">

                    <button type="button" class="btn btn-box-tool" data-widget="collapse">

                        <i class="fa fa-minus"></i>

                    </button>

                </div>

            </div>


            <!-- ================= BODY ================= -->

            <div class="box-body">

                <form id="uploadForm" action="@Url.Action("UploadItemMasterExcelApr26", "Master")" method="post" enctype="multipart/form-data">


                    <div class="row">

                        <div class="col-md-8">

                            <!-- SELECT MASTER + DOWNLOAD TEMPLATE -->

                            <div class="form-group">

                                <div class="row">

                                    <!-- Select Master Label -->

                                    <div class="col-md-4">

                                        <label>
                                            Select Master
                                        </label>

                                    </div>


                                    <!-- Dropdown -->

                                    <div class="col-md-6">

                                        @*<select name="MasterType" id="MasterType" class="form-control" required>

                                                <option value="">
                                                    -- Select Master --
                                                </option>

                                                <option value="ItemMaster">
                                                    Item Master
                                                </option>

                                                <option value="SuplierMaster">
                                                    Suplier Master
                                                </option>

                                                <option value="CustomerMaster">
                                                    Customer Master
                                                </option>

                                            </select>*@

                                        @Html.DropDownList("TableName", ViewBag.TableList as SelectList, "Select Tables", new { @class = "form-control", @id = "TableName" })


                                    </div>


                                    <!-- Download Template Button -->

                                    <div class="col-md-2">

                                        <button type="button" id="btnDownloadTemplate" class="btn btn-primary" style="white-space:nowrap;">

                                            Download Template

                                        </button>

                                    </div>

                                </div>

                            </div>


                            <!-- ATTACH EXCEL FILE -->

                            <div class="form-group">

                                <div class="row">

                                    <div class="col-md-4">

                                        <label> Attach Excel File </label>

                                    </div>


                                    <div class="col-md-6">

                                        <input type="file" name="ExcelFile" class="form-control" accept=".xls,.xlsx" required />

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- ================================================= -->
                    <!-- UPLOAD BUTTON -->
                    <!-- ================================================= -->

                    <div class="row">

                        <div class="col-md-12 text-center"
                             style="margin-top:20px;">

                            <button type="submit" form="uploadForm" class="btn btn-success">

                                Upload

                            </button>


                            @*@Html.ActionLink( "Back", "ItemList17Dec", "Master", null, new { @class = "btn btn-primary" } )*@

                        </div>

                    </div>


                    <!-- ================================================= -->
                    <!-- ERROR MESSAGE -->
                    <!-- ================================================= -->

                    @if (ViewBag.Message != null)
                    {

                        <div class="result-box"
                             style="border-left:4px solid red; margin-top:15px;">

                            <b style="color:red;">
                                @ViewBag.Message
                            </b>

                        </div>

                    }

                </form>

            </div>

        </div>

    </div>

</section>



<!-- UPLOAD RESULT SECTION -->

<section id="Test">

    <div class="col-lg-12 col-md-12">

        <div class="box box-info">

            <!-- ================= HEADER ================= -->

            <div class="box-header with-border">

                <h3 class="box-title">
                    Upload Result
                </h3>


                <div class="box-tools pull-right">

                    <button type="button" class="btn btn-box-tool" data-widget="collapse">

                        <i class="fa fa-minus"></i>

                    </button>

                </div>

            </div>


            <!-- ================= RESULT BODY ================= -->

            <div class="box-body">

                <div id="resultBody">

                    <div class="result-box">

                        <!-- SUCCESS / FAIL COUNT -->

                        <div style="display:flex; gap:15px; margin-bottom:10px;">

                            <div style="flex:1; border:1px solid #c8e6c9; padding:10px;">

                                <b style="color:green;">
                                    Success Count
                                </b>

                                <h3>
                                    @(ViewBag.SuccessCount ?? 0)
                                </h3>

                            </div>

                            <div style="flex:1; border:1px solid #ffcdd2; padding:10px;">

                                <b style="color:red;">
                                    Fail Count
                                </b>

                                <h3>
                                    @(ViewBag.FailCount ?? 0)
                                </h3>

                            </div>


                        </div>

                        <!-- DOWNLOAD FAIL RECORDS -->

                        @Html.ActionLink("Download Fail Records", "DownloadFailRecords", "Master", null, new { @class = "btn btn-info" })


                    </div>

                </div>

            </div>

        </div>

    </div>

</section>



<!-- JAVASCRIPT -->

<script>

    $(document).ready(function () {

    $("#btnDownloadTemplate").click(function () {

        var selectedTable = $("#TableName").val();

        if (!selectedTable || selectedTable === "") {
            alert("Please select Table.");
            return;
        }

        // Redirecting to the DownloadTemplate action in the controller will download the file.
        var downloadUrl = '@Url.Action("DownloadTemplate", "Master")' + '?tableName=' + encodeURIComponent(selectedTable);
        window.location.href = downloadUrl;

    });

});
}}