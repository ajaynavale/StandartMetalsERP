@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

<script type="text/javascript">

    $(document).ready(function () {

        $("#AddCustForm").removeData("validator");
        $("#AddCustForm").removeData("unobtrusiveValidation");
        $.validator.unobtrusive.parse("#AddCustForm");

        $("#AddCustForm select").select2({
            width: "100%",
            placeholder: "Select",
            closeOnSelect: true,
            allowClear: true,
            dropdownParent: $("#myModal .modal-content")
        });


        $(document).on("submit", "#AddCustForm", function (e) {
            e.preventDefault();

            var form = $(this);

            if (!form.valid()) {
                return false;
            }

            $.ajax({
                url: form.attr("action"),
                type: "POST",
                data: form.serialize(),
                success: function (response) {
                    alert(response.Messages + "\n\n Generated Customer Code is : " + response.code);

                    $(".modal").modal("hide");
                    location.reload();

                }
            });

        });

    });


</script>

