@model StandardMetals.MODEL.ItemMasterModalApril2026


<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Add New Items</title>
</head>
<body>
    <!-----------Model Header--------->

    <div class="modal-dialog modal-lg custom-modal-sm">
        <div class="modal-content">
            <div class="modal-header custom-header" style="display:flex;">
                <h2>Add New Item</h2>
                <button type="button" class="close" data-dismiss="modal" style="margin-left:auto;">&times;</button>
            </div>

            <div class="modal-body" style="padding-bottom:0px">
                <section id="Test">
                    <div>

                        <div class="box box-info">
                            <!-- /.box-header -->

                            <div class="box-body">
                                <div class="formcolor section-box">

                                    @*================================================================================================*@
                                    @using (Html.BeginForm("AddNewItem17Dec", "Master", FormMethod.Post, new { id = "UpdateId" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <div class="form-horizontal">
                                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                            <div class="row">
                                                <div class="col-md-2">
                                                    @Html.LabelFor(model => model.ItemCode, htmlAttributes: new { @class = "control-label col-md-2" })
                                                </div>
                                                <div class="col-md-4">
                                                    @Html.EditorFor(model => model.ItemCode, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                                                    @Html.ValidationMessageFor(model => model.ItemCode, "", new { @class = "text-danger" })
                                                </div>



                                                <div class="col-md-2">
                                                    @Html.LabelFor(model => model.ItemName, "Name", htmlAttributes: new { @class = "control-label col-md-2" })
                                                </div>
                                                <div class="col-md-4">
                                                    @Html.EditorFor(model => model.ItemName, new { htmlAttributes = new { @class = "form-control" } })
                                                    @Html.ValidationMessageFor(model => model.ItemName, "", new { @class = "text-danger" })
                                                </div>

                                            </div>

                                            <div class="row">
                                                <div class="col-md-2">
                                                    @Html.LabelFor(model => model.ManufactureId, "Manufacturer", htmlAttributes: new { @class = "control-label col-md-2" })
                                                </div>
                                                <div class="col-md-4">
                                                    @Html.DropDownListFor(model => model.ManufactureId,
                                                    new SelectList(ViewBag.Manufacturers, "ManufactureId", "ManufactureName"), "Select",
                                                    htmlAttributes: new { @class = "form-control" })
                                                    @Html.ValidationMessageFor(model => model.ManufactureId, "", new { @class = "text-danger" })
                                                </div>

                                                <div class="col-md-2">
                                                    @Html.LabelFor(model => model.Material, htmlAttributes: new { @class = "control-label col-md-2" })
                                                </div>
                                                <div class="col-md-4">
                                                    @Html.EditorFor(model => model.Material, new { htmlAttributes = new { @class = "form-control" } })
                                                    @Html.ValidationMessageFor(model => model.Material, "", new { @class = "text-danger" })
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-md-2">
                                                    @Html.LabelFor(model => model.CategoryId, "Category", htmlAttributes: new { @class = "control-label col-md-2" })
                                                </div>
                                                <div class="col-md-4">
                                                    @Html.DropDownListFor(model => model.CategoryId,
                                                    new SelectList(ViewBag.Categories, "CategoryId", "CategoryName"), "Select",
                                                    htmlAttributes: new { @class = "form-control" })
                                                    @Html.ValidationMessageFor(model => model.CategoryId, "", new { @class = "text-danger" })
                                                </div>


                                                <div class="col-md-2">
                                                    @Html.LabelFor(model => model.SubCategoryId, "SubCategory", htmlAttributes: new { @class = "control-label col-md-2" })
                                                </div>
                                                <div class="col-md-4">
                                                    @Html.DropDownListFor(model => model.SubCategoryId,
                                                    new SelectList(ViewBag.SubCategories, "SubCategoryId", "SubCategoryName"), "Select",
                                                    htmlAttributes: new { @class = "form-control" })
                                                    @Html.ValidationMessageFor(model => model.SubCategoryId, "", new { @class = "text-danger" })
                                                </div>
                                            </div>



                                            <div class="row">
                                                <div class="col-md-2">
                                                    @Html.LabelFor(model => model.ColourId, "Colour", htmlAttributes: new { @class = "control-label col-md-2" })
                                                </div>
                                                <div class="col-md-4">
                                                    @Html.DropDownListFor(model => model.ColourId,
                                                   new SelectList(ViewBag.ColourList, "ColourId", "ColourName"), "Select",
                                                   htmlAttributes: new { @class = "form-control" })
                                                    @Html.ValidationMessageFor(model => model.ColourId, "", new { @class = "text-danger" })
                                                </div>

                                                <div class="col-md-2">
                                                    @Html.LabelFor(model => model.UnitId, "Unit", htmlAttributes: new { @class = "control-label col-md-2" })
                                                </div>
                                                <div class="col-md-4">
                                                    @Html.DropDownListFor(model => model.UnitId,
                                                    new SelectList(ViewBag.UnitList, "UnitId", "UnitName"), "Select",
                                                    htmlAttributes: new { @class = "form-control" })
                                                    @Html.ValidationMessageFor(model => model.UnitId, "", new { @class = "text-danger" })
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-md-2">
                                                    @Html.LabelFor(model => model.HSNCODE, "HSN-Code", htmlAttributes: new { @class = "control-label col-md-2" })
                                                </div>
                                                <div class="col-md-4">
                                                    @Html.EditorFor(model => model.HSNCODE, new { htmlAttributes = new { @class = "form-control" } })
                                                    @Html.ValidationMessageFor(model => model.HSNCODE, "", new { @class = "text-danger" })
                                                </div>


                                                <div class="col-md-2">
                                                    @Html.LabelFor(model => model.GSTRate, "GST Rate", htmlAttributes: new { @class = "control-label col-md-2" })
                                                </div>
                                                <div class="col-md-4">
                                                    @Html.EditorFor(model => model.GSTRate, new { htmlAttributes = new { @class = "form-control" } })
                                                    @Html.ValidationMessageFor(model => model.GSTRate, "", new { @class = "text-danger" })
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-md-2">
                                                    @Html.LabelFor(model => model.PurchaseCost, htmlAttributes: new { @class = "control-label col-md-2" })
                                                </div>
                                                <div class="col-md-4">
                                                    @Html.EditorFor(model => model.PurchaseCost, new { htmlAttributes = new { @class = "form-control" } })
                                                    @Html.ValidationMessageFor(model => model.PurchaseCost, "", new { @class = "text-danger" })
                                                </div>


                                                <div class="col-md-2">
                                                    @Html.LabelFor(model => model.SellingPrice, htmlAttributes: new { @class = "control-label col-md-2" })
                                                </div>
                                                <div class="col-md-4">
                                                    @Html.EditorFor(model => model.SellingPrice, new { htmlAttributes = new { @class = "form-control" } })
                                                    @Html.ValidationMessageFor(model => model.SellingPrice, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                            <br />
                                            <br />
                                            <!--Supplier Grid Start From Here -->
                                            <section id="SupplierMaster">

                                                <div class="col-lg-12 col-md-12">

                                                    <div class="box box-info">

                                                        <div class="box-header with-border">

                                                            <h3>
                                                                Supplier Details
                                                            </h3>
                                                        </div>


                                                        <div class="box-body">

                                                            <div class="col-md-4">

                                                                <strong class="align text-center">
                                                                    Supplier Code
                                                                </strong>

                                                                <div class="dropdown">

                                                                    @Html.DropDownList("SupplierCodeDrp", ViewBag.SupplierCode as SelectList,  "Select Supplier Code",
                                                                        new  { @class = "form-control", id = "ddlSearchSuppCode" } )

                                                                </div>

                                                            </div>


                                                            <div class="col-md-4">

                                                                <strong class="align text-center">
                                                                    Supplier Name
                                                                </strong>

                                                                <div class="dropdown">

                                                                    @Html.DropDownList("SupplierNameDrp", ViewBag.SupplierName as SelectList, "Select Supplier Name",
                                                                        new { @class = "form-control", id = "ddlSearchSuppName" } )

                                                                </div>

                                                            </div>


                                                            <div class="col-md-2">

                                                                <div class="form-group">

                                                                    <label>&nbsp;</label>

                                                                    <br />

                                                                    <input id="btnAddSupplier" type="button" value="Add" class="btn btn-sm- btn-primary" />

                                                                </div>

                                                            </div>


                                                            <!-- ADDED SUPPLIER LIST                      -->

                                                            <div class="col-md-12"
                                                                 style="margin-top:15px;">

                                                                <table id="tblItemSupplier"
                                                                       class="table table-bordered table-striped">

                                                                    <thead>

                                                                        <tr>
                                                                            <th> Supplier Code </th>

                                                                            <th>Supplier Name</th>

                                                                            <th style="width:100px;"> Action </th>

                                                                        </tr>

                                                                    </thead>

                                                                    <tbody id="supplierListBody"></tbody>

                                                                </table>

                                                            </div>

                                                        </div>

                                                    </div>

                                                </div>

                                            </section>

                                            <br />
                                            <br />
                                            <!--Customer Grid Start From Here -->
                                            <section id="CustomerMaster">

                                                <div class="col-lg-12 col-md-12">

                                                    <div class="box box-info">

                                                        <div class="box-header with-border">

                                                            <h3>
                                                                Customer Details
                                                            </h3>
                                                        </div>


                                                        <div class="box-body">

                                                            <div class="col-md-4">

                                                                <strong class="align text-center">
                                                                    Customer Code
                                                                </strong>

                                                                <div class="dropdown">

                                                                    @Html.DropDownList("CustomerCodeDrp", ViewBag.CustomerCode as SelectList,  "Select Customer Code",
                                                                        new  { @class = "form-control", id = "ddlSearchCustCode" } )

                                                                </div>

                                                            </div>


                                                            <div class="col-md-4">

                                                                <strong class="align text-center">
                                                                    Customer Name
                                                                </strong>

                                                                <div class="dropdown">

                                                                    @Html.DropDownList("CustomerNameDrp", ViewBag.CustomerName as SelectList, "Select Customer Name",
                                                                        new { @class = "form-control", id = "ddlSearchCustName" } )

                                                                </div>

                                                            </div>


                                                            <div class="col-md-2">

                                                                <div class="form-group">

                                                                    <label>&nbsp;</label>

                                                                    <br />

                                                                    <input id="btnAddCustomer" type="button" value="Add" class="btn btn-sm- btn-primary" />

                                                                </div>

                                                            </div>


                                                            <!--  added Customer List                 -->

                                                            <div class="col-md-12"
                                                                 style="margin-top:15px;">

                                                                <table id="tblItemCustomer"
                                                                       class="table table-bordered table-striped">

                                                                    <thead>

                                                                        <tr>
                                                                            <th> Customer Code </th>

                                                                            <th> Customer Name </th>

                                                                            <th style="width:100px;"> Action </th>

                                                                        </tr>

                                                                    </thead>

                                                                    <tbody id="CustomerListBody"></tbody>

                                                                </table>

                                                            </div>

                                                        </div>

                                                    </div>

                                                </div>

                                            </section>


                                            <div class="form-group">
                                                <div class="modal-footer justify-content-end">
                                                    <input type="submit" value="Save" class="btn btn-success" />
                                                </div>
                                            </div>
                                        </div>
                                    }

                                    <!-----------Model Footer--------->
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
</body>
</html>

<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

<script>

    $(document).ready(function () {

        // enable mvc client side validation

        $("#UpdateId").removeData("validator");
        $("#UpdateId").removeData("unobtrusiveValidation");
        $.validator.unobtrusive.parse("#UpdateId");

        // select2 for drp search
        $("#UpdateId select").select2({
            width: "100%",
            placeholder: "Select",
            closeOnSelect: true,
            allowClear: true,
            dropdownParent: $("#myModal .modal-content")
        });


        // dynamically subcategory depend on category

        $("#CategoryId").change(function ()
        {

            var categoryId = $(this).val();
            var subCategory = $("#SubCategoryId");

            subCategory.empty();

            subCategory.append($("<option></option>").val("").text("Select"));

            if (!categoryId)
            {
                subCategory.val("").trigger("change");
                return;
            }

            $.ajax({
                url: '@Url.Action("GetSubCategoryN", "Master")',
                type: "GET",
                data: { id: categoryId },

                success: function (data) {

                    $.each(data, function (i, item) {

                        subCategory.append( $("<option></option>").val(item.SubCategoryId).text(item.SubCategoryName));

                    });

                    subCategory.trigger("change.select2");
                },

                error: function ()
                {
                    alert("Unable to load sub categories.");
                }
            });

        });

        // suppliercode select, auto suppliername get selected

        $("#ddlSearchSuppCode").change(function () {

            var supplierId = $(this).val();

            $("#ddlSearchSuppName").val(supplierId).trigger("change.select2");

        });

        // suplliername select, auto suppliercode get selectec
        $("#ddlSearchSuppName").change(function () {

            var supplierId = $(this).val();

            $("#ddlSearchSuppCode").val(supplierId).trigger("change.select2");

        });


        // customer code select auto customername get selected

        $("#ddlSearchCustCode").change(function () {

            var customerId = $(this).val();

            $("#ddlSearchCustName").val(customerId).trigger("change.select2");

        });

        // suppliername select auto suppliercode get selectec
        $("#ddlSearchCustName").change(function () {

            var customerId = $(this).val();

            $("#ddlSearchCustCode").val(customerId).trigger("change.select2");

        });


        // supplier list index

        function rebuildSupplierIndexes() {

            $("#supplierListBody tr").each(function (index) {

                $(this).find("input[name*='SupplierID']").attr("name",`SupplierList[${index}].SupplierID`);

            });

        }

        // add supplier

        $("#btnAddSupplier").click(function () {

            var supplierId = $("#ddlSearchSuppCode").val();
            var supplierCode = $("#ddlSearchSuppCode option:selected").text();
            var supplierName = $("#ddlSearchSuppName option:selected").text();

            if (!supplierId) {

                alert("Please select Supplier.");
                return;

            }


            // Prevent duplicate supplier
            var exists = false;

            $("#supplierListBody input[name*='.SupplierID']").each(function () {

                if ($(this).val() == supplierId) {
                    exists = true;
                }

            });


            if (exists) {

                alert("Supplier already added.");
                return;

            }


            var row = `<tr>

                    <td>
                        ${supplierCode}

                        <input type="hidden"
                               name="SupplierList[0].SupplierID"
                               value="${supplierId}" />
                    </td>
                    <td>
                    ${supplierName}
                    </td>

                    <td>
                        <button type="button"
                                class="btn btn-danger btn-sm btnRemoveSupplier">
                            Remove
                        </button>
                    </td>

                </tr>`;


            $("#supplierListBody").append(row);

            // Fix indexes: 0,1,2,3...
            rebuildSupplierIndexes();


            // Clear supplier dropdowns
            $("#ddlSearchSuppCode, #ddlSearchSuppName")
                .val("")
                .trigger("change.select2");

        });


        // remove supplier

        $(document).on("click", ".btnRemoveSupplier", function () {

            $(this).closest("tr").remove();

            // Rebuild indexes after removing row
            rebuildSupplierIndexes();

        });

        // customer list index

        function rebuildCustomerIndexes() {

            $("#CustomerListBody tr").each(function (index) {

                $(this).find("input[name*='CustomerId']").attr("name", `CustList[${index}].CustomerId`);

            });

        }

        // add supplier

        $("#btnAddCustomer").click(function () {

            var CustomerId = $("#ddlSearchCustCode").val();
            var CustomerCode = $("#ddlSearchCustCode option:selected").text();
            var CustomerName = $("#ddlSearchCustName option:selected").text();

            if (!CustomerId) {

                alert("Please select Customer.");
                return;

            }


            // Prevent duplicate supplier
            var exists = false;

            $("#CustomerListBody input[name*='.CustomerId']").each(function () {

                if ($(this).val() == CustomerId) {
                    exists = true;
                }

            });


            if (exists) {

                alert("Customer already added.");
                return;

            }


            var row = `<tr>

                    <td>
                        ${CustomerCode}

                        <input type="hidden"
                               name="CustList[0].CustomerId"
                               value="${CustomerId}" />
                    </td>
                    <td>
                    ${CustomerName}
                    </td>

                    <td>
                        <button type="button"
                                class="btn btn-danger btn-sm btnRemoveCustomer">
                            Remove
                        </button>
                    </td>

                </tr>`;


            $("#CustomerListBody").append(row);

            // Fix indexes: 0,1,2,3...
            rebuildCustomerIndexes();


            // Clear customer dropdowns
            $("#ddlSearchCustCode, #ddlSearchCustName")
                .val("")
                .trigger("change.select2");

        });


        // remove customer

        $(document).on("click", ".btnRemoveCustomer", function () {

            $(this).closest("tr").remove();

            // Rebuild indexes after removing row
            rebuildCustomerIndexes();

        });


        // form submite

        $("#UpdateId").submit(function (e) {

            e.preventDefault();

            // MVC client-side validation
            if (!$(this).valid())
            {
                return false;
            }

            // ajax call

            $.ajax({

                url: this.action,
                type: "POST",
                data: $(this).serialize(),

                success: function (response) {

                    if (response.success) {

                        alert(response.message +"\n\nGenerated ItemCode : " +response.code);

                        location.reload();

                    }
                    else {

                        alert(response.message);

                    }

                },

                error: function (xhr) {

                    console.log(xhr.responseText);

                    alert("Error while saving item.");

                }

            });


            return false;

        });

    });

</script>

<style>
    .row {
        padding: 10px;
    }

    .section-box {
        padding-top: 5px;
    }

    .modal-body {
        padding-top: 5px;
    }

    .form-title {
        margin-left: 8 px;
        font-size: 24px;
    }
</style>